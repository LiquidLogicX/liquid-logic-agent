{
  "type": "https://ercs.ethereum.org/ERCS/erc-8257#tool-manifest-v1",
  "name": "Liquid Logic Agent — Wallet Audit",
  "description": "Liquid Logic X wallet audit for AI agents. Send an agent wallet address and get a structured USDC spend summary from the Liquid Logic X public ledger on Base: payment count, total USDC, spend by destination endpoint with Basescan links, recent payments, and hold/deny/freeze counts. Paid per call via x402: 0.05 USDC on Base. Call with GET ?wallet=0x… or POST JSON {\"wallet\":\"0x…\"}. Site: https://liquidlogicx.com",
  "endpoint": "https://audit.liquidlogicx.com/api/audit",
  "inputs": {
    "type": "object",
    "properties": {
      "wallet": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$",
        "description": "Agent wallet address (0x…) to audit"
      }
    },
    "required": [
      "wallet"
    ]
  },
  "outputs": {
    "type": "object",
    "properties": {
      "walletAddress": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "network": {
        "type": "string",
        "const": "eip155:8453"
      },
      "asset": {
        "type": "string",
        "const": "USDC"
      },
      "source": {
        "type": "string",
        "const": "public_ledger"
      },
      "paymentCount": {
        "type": "integer"
      },
      "totalUsdc": {
        "type": "number"
      },
      "held": {
        "type": "integer"
      },
      "denied": {
        "type": "integer"
      },
      "expired": {
        "type": "integer"
      },
      "frozenSeconds": {
        "type": "number"
      },
      "destinations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "count": {
              "type": "integer"
            },
            "totalUsdc": {
              "type": "number"
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "amountUsdc": {
                    "type": "string"
                  },
                  "txHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "basescanUrl": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string"
                  }
                },
                "required": [
                  "amountUsdc",
                  "timestamp"
                ]
              }
            }
          },
          "required": [
            "endpoint",
            "count",
            "totalUsdc",
            "examples"
          ]
        }
      },
      "recent": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "amountUsdc": {
              "type": "string"
            },
            "txHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "basescanUrl": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "endpoint",
            "amountUsdc",
            "timestamp"
          ]
        }
      },
      "note": {
        "type": "string"
      }
    },
    "required": [
      "walletAddress",
      "network",
      "asset",
      "source",
      "paymentCount",
      "totalUsdc",
      "destinations",
      "recent",
      "note"
    ]
  },
  "version": "1.0.0",
  "image": "https://audit.liquidlogicx.com/ai-tool/llx-logo.png",
  "featuredImage": "https://audit.liquidlogicx.com/ai-tool/llx-banner.png",
  "tags": [
    "ai",
    "defi",
    "security"
  ],
  "pricing": [
    {
      "amount": "50000",
      "asset": "eip155:8453/erc20:0x833589fcd6edb6e08f4c7c32d4f71b54bda02913",
      "recipient": "eip155:8453:0x147991a1c25e78f6d9225d2dba61ed93a6158c7b",
      "protocol": "x402"
    }
  ],
  "creatorAddress": "0x0000000000000000000000000000000000000000"
}
