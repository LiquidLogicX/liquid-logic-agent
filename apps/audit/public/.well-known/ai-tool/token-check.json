{
  "type": "https://ercs.ethereum.org/ERCS/erc-8257#tool-manifest-v1",
  "name": "Base Token Safety/Rug Check",
  "description": "Check a Base token before your agent buys it, via Liquid Logic X: send an ERC-20 address, get risk (low/medium/high), score, flags and evidence: owner, upgradeable proxy, mint/blacklist/fee/pause powers in code, owner and burn %, DEX liquidity, pair age, 24h buys vs sells, X-Lock locks. $0.01 USDC on Base. Site: https://liquidlogicx.com",
  "endpoint": "https://audit.liquidlogicx.com/api/token-check",
  "inputs": {
    "type": "object",
    "properties": {
      "token": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$",
        "description": "Base (eip155:8453) ERC-20 token contract address to check before buying."
      },
      "chain": {
        "type": "string",
        "enum": [
          "base"
        ],
        "description": "Optional. Base only."
      }
    },
    "required": [
      "token"
    ]
  },
  "outputs": {
    "type": "object",
    "properties": {
      "token": {
        "type": "string"
      },
      "chain": {
        "type": "string",
        "enum": [
          "base"
        ]
      },
      "checkedAt": {
        "type": "string",
        "format": "date-time"
      },
      "risk": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "description": "Worst flag severity found. 'low' is not a guarantee."
      },
      "score": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "description": "100 minus 35 per high, 15 per medium, 5 per low flag"
      },
      "summary": {
        "type": "string"
      },
      "flags": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "e.g. POWER_MINT, POWER_BLACKLIST, UPGRADEABLE, OWNER_HOLDS_MAJORITY, LIQUIDITY_TINY, NO_SELLS_24H, PAIR_NEW, NO_DEX_PAIR, OWNER_RENOUNCED, XLOCK_LOCKED, KNOWN_ISSUER"
            },
            "severity": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low",
                "info"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "contract": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "decimals": {
            "type": [
              "integer",
              "null"
            ]
          },
          "totalSupply": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerRenounced": {
            "type": "boolean"
          },
          "upgradeable": {
            "type": "boolean"
          },
          "proxyImplementation": {
            "type": [
              "string",
              "null"
            ]
          },
          "proxyAdmin": {
            "type": [
              "string",
              "null"
            ]
          },
          "adminPowersInCode": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mint",
                "blacklist",
                "fees",
                "pause",
                "trading-switch",
                "max-tx"
              ]
            }
          },
          "knownIssuer": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "holders": {
        "type": "object",
        "properties": {
          "ownerPct": {
            "type": [
              "number",
              "null"
            ]
          },
          "burnedPct": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "market": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "pairCount": {
            "type": "integer"
          },
          "totalLiquidityUsd": {
            "type": [
              "number",
              "null"
            ]
          },
          "topPair": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "dex": {
                "type": "string"
              },
              "pairAddress": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "quoteSymbol": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "liquidityUsd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "priceUsd": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "volume24hUsd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "buys24h": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "sells24h": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "createdAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        }
      },
      "locks": {
        "type": "object",
        "properties": {
          "xlockLocked": {
            "type": "boolean"
          },
          "pctOfSupplyLocked": {
            "type": [
              "number",
              "null"
            ]
          },
          "nextUnlock": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lockUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "notChecked": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "links": {
        "type": "object",
        "properties": {
          "basescan": {
            "type": "string"
          },
          "dexscreener": {
            "type": "string"
          }
        }
      },
      "source": {
        "type": "string"
      }
    },
    "required": [
      "token",
      "chain",
      "checkedAt",
      "risk",
      "score",
      "summary",
      "flags",
      "contract",
      "market",
      "locks"
    ]
  },
  "version": "1.0.0",
  "image": "https://audit.liquidlogicx.com/ai-tool/llx-logo.png",
  "featuredImage": "https://audit.liquidlogicx.com/ai-tool/llx-banner.png",
  "tags": [
    "rug-check",
    "token-safety",
    "honeypot",
    "base",
    "trading"
  ],
  "pricing": [
    {
      "amount": "10000",
      "asset": "eip155:8453/erc20:0x833589fcd6edb6e08f4c7c32d4f71b54bda02913",
      "recipient": "eip155:8453:0x147991a1c25e78f6d9225d2dba61ed93a6158c7b",
      "protocol": "x402"
    }
  ],
  "creatorAddress": "0x0000000000000000000000000000000000000000"
}
