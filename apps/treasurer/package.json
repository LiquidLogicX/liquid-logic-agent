{
  "name": "@liquid-logic/treasurer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "ll-treasurer": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node --import tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "set-allowance": "npm run cli -- set-allowance",
    "top-up": "npm run cli -- top-up",
    "revoke": "npm run cli -- revoke",
    "pay": "npm run cli -- pay",
    "print-wallet-address": "npm run cli -- print-wallet-address"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.55.0",
    "@liquid-logic/shared": "*",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/svm": "^2.25.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
