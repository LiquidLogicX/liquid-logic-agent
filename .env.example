# === CDP credentials (never commit real values) ===
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# === Treasurer (apps/treasurer) — Base mainnet by default ===
# Omit CDP_X402_ENVIRONMENT (or leave empty) for Base mainnet.
# Set to "development" only for Base Sepolia local testing.
# CDP_X402_ENVIRONMENT=
TREASURER_LEDGER_PATH=./data/ledger.jsonl
# Production Render allowlist is also published in public/policy.json
# (and packages/shared DEFAULT_TREASURER_POLICY). Keep them in sync.
TREASURER_ALLOWLIST=https://audit.liquidlogicx.com/api/audit,https://liquid-logic-agent-audit.vercel.app/api/audit,https://x402uselessfacts.vercel.app/api/useless-fact
TREASURER_MAX_PER_PAYMENT_USDC=1.00
TREASURER_DAILY_CAP_USDC=10.00
TREASURER_WALLET_ACCOUNT_NAME=x402-client-wallet-1
AGENT_WALLET_ADDRESS=0xEA24bafbBAF6d7Ba58bE860EE906f0Fe533d167D

# === Audit seller (apps/audit) — /api/audit $0.05 and /api/allowance $0.001 ===
# EVM address that receives fees (CDP-managed or external).
AUDIT_PAY_TO_EVM=
# Optional: same TREASURER_* names as Render so pre-flight matches live caps.
# If unset, audit uses packages/shared DEFAULT_TREASURER_POLICY (public/policy.json).
# Optional: force development facilitator / Sepolia (omit for mainnet)
# CDP_X402_SERVER_ENVIRONMENT=production
NEXT_PUBLIC_LEDGER_BASE_URL=https://liquidlogicx.com
LEDGER_PUBLIC_DIR=../../public/ledger

# === Web (apps/web) ===
NEXT_PUBLIC_SITE_URL=https://liquidlogicx.com
NEXT_PUBLIC_AUDIT_URL=https://audit.liquidlogicx.com
NEXT_PUBLIC_LEDGER_URL=/ledger
# $LLX Virtuals contract. Leave empty until the address is provided — homepage renders nothing for it.
NEXT_PUBLIC_LLX_CONTRACT=

# === Ledger publisher ===
LEDGER_JSONL_PATH=./data/ledger.jsonl
LEDGER_OUT_DIR=./public/ledger
SOCIAL_DRAFTS_DIR=./drafts/social
AGENT_WALLET_ADDRESS=

# === Audit ledger read (live published ledger + local files) ===
# Default: https://liquidlogicx.com  Set empty or LEDGER_SKIP_REMOTE=1 to disable fetch.
# LEDGER_REMOTE_BASE_URL=https://liquidlogicx.com
# LEDGER_SKIP_REMOTE=
# LEDGER_JSONL_PATH=./data/ledger.jsonl

# === Operator HTTP (treasurer — principal bearer, NOT x402) ===
# Required on Render for freeze/unfreeze + hold approve/deny/list. Fail closed if unset.
# Public HTTPS base: Render web service URL (phone-reachable). Never put this on the x402 rail.
# LLX_OPERATOR_TOKEN=
# OPERATOR_HTTP_PORT=10000
#
# Hold threshold (takeover step 3). Unset = no holds (pay as today).
# At/above threshold → ledger type `held`; approve/deny via HTTP; unanswered → `expired`.
# HOLD_ABOVE_USDC=
# HOLD_TTL_SECONDS=3600
